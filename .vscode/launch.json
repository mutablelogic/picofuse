{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug sys_001",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build-pico/test/sys_001.elf",
            "request": "launch",
            "type": "cortex-debug",
            "servertype": "openocd",
            "serverpath": "/opt/openocd/openocd",
            "searchDir": [
                "/opt/openocd/scripts"
            ],
            "configFiles": [
                "interface/cmsis-dap.cfg",
                "target/rp2350.cfg"
            ],
            "openOCDLaunchCommands": [
                "adapter speed 5000"
            ],
            "gdbPath": "/opt/homebrew/bin/arm-none-eabi-gdb",
            "runToEntryPoint": "main",
            "showDevDebugOutput": "raw"
        },
        {
            "name": "Debug stdin echo",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build-pico/examples/stdin/stdin.elf",
            "request": "launch",
            "type": "cortex-debug",
            "servertype": "openocd",
            "serverpath": "/opt/openocd/openocd",
            "searchDir": [
                "/opt/openocd/scripts"
            ],
            "configFiles": [
                "interface/cmsis-dap.cfg",
                "target/rp2350.cfg"
            ],
            "openOCDLaunchCommands": [
                "adapter speed 5000"
            ],
            "gdbPath": "/opt/homebrew/bin/arm-none-eabi-gdb",
            "runToEntryPoint": "main",
            "showDevDebugOutput": "raw"
        }
    ]
}